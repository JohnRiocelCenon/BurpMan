meta {
  name: 02 - JWT token source mock
  type: http
  seq: 2
}

post {
  url: {{base_url}}/response-headers?access_token={{mock_access_token}}&token_type=Bearer&expires_in=75
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{oauth_client_id}}
  client_secret: {{oauth_client_secret}}
  scope: {{oauth_scope}}
}

tests {
  test("02 - status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("02 - token fields present", function() {
    var body = res.getBody();
    expect(body.access_token).to.equal("BRUNO-MOCK-TOKEN-XYZ");
    expect(body.token_type).to.equal("Bearer");
  });
}
