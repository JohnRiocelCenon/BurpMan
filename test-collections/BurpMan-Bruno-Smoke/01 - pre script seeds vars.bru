meta {
  name: 01 - pre script seeds vars
  type: http
  seq: 1
}

get {
  url: https://httpbin.org/get?stage=01&run={{bruno.run_id}}
  body: none
  auth: none
}

script:pre-request {
  bru.setEnvVar("bruno.run_id", "run-" + Date.now());
  bru.setEnvVar("bruno.user", "bruno-smoke");
}

tests {
  test("01 - status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("01 - run id interpolated", function() {
    var args = res.getBody().args;
    expect(args.run).to.match(/^run-\d+$/);
  });
}
